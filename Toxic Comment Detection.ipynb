    "if SMOTE_RAN:\n",
    "    compare(smote_label, 'BR — SVM, balanced (TF-IDF)', 'SMOTE')\n",
    "compare('Classifier Chain (TF-IDF+bigrams)', 'BR — SVM, balanced (TF-IDF)', 'Classifier Chains')\n",
    "compare('BR — SVM Tuned (GridSearchCV)', 'BR — SVM, balanced (TF-IDF)', 'Tuning')\n",
    "\n",
    "best = max(f1_map, key=f1_map.get)\n",
    "print(f'\\n• Best overall (macro F1): {best} ({f1_map[best]:.3f})')\n",
