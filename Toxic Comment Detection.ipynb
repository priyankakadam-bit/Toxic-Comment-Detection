    "# 12.4  Findings computed from the results above (so the text can never contradict the numbers)\n",
    "f1_map = {name: m['macro_f1'] for name, m in all_metrics}\n",
    "hl_map = {name: m['hamming_loss'] for name, m in all_metrics}\n",
