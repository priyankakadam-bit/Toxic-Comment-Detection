    "for ix, label in enumerate(LABEL_DISPLAY):\n",
    "    print(f'  ▸ {label}')\n",
    "    print(classification_report(Y_test[:, ix], Y_pred_chain[:, ix],\n",
    "                                 target_names=['Not Toxic', 'Toxic'], zero_division=0))"
