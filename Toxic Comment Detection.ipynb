    "def compare(a, b, what):\n",
    "    diff = f1_map[a] - f1_map[b]\n",
    "    verdict = 'better than' if diff > 0.005 else 'worse than' if diff < -0.005 else 'about the same as'\n",
    "    print(f'• {what}: {a} is {verdict} {b} '\n",
    "          f'(macro F1 {f1_map[a]:.3f} vs {f1_map[b]:.3f})')\n",
